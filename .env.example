# ─── web-terminal configuration ──────────────────────────────────────────────
# Copy to `.env` and fill in. All variables are optional unless noted.
# The server reads real environment variables; `.env` is just where you keep
# them (load it with your process manager, docker-compose, or `set -a; . ./.env`).

# ── Network ──────────────────────────────────────────────────────────────────
PORT=7681
# Bind address. 127.0.0.1 = localhost only (put a reverse proxy in front).
# 0.0.0.0 = all interfaces (LAN / Docker). 
BIND=127.0.0.1

# Public origin(s) the browser uses, comma-separated. Needed for the WebSocket
# Origin check when served behind a proxy on a real hostname.
# WEB_TERMINAL_ORIGIN=https://terminal.example.com

# ── Cookie signing (REQUIRED for stable logins) ──────────────────────────────
# A long random string. If unset, a random one is generated at boot, which logs
# everyone out on every restart. Generate: openssl rand -hex 32
# WEB_TERMINAL_SECRET=

# ── Auth: choose at least ONE method ─────────────────────────────────────────

# Method A — shared password (simplest for self-hosting behind a VPN/LAN).
# WEB_TERMINAL_PASSWORD=change-me-to-something-long
# Name recorded as the session owner for password/bypass logins.
# WEB_TERMINAL_USER=user

# Method B — Google OAuth. Create an OAuth client at
# https://console.cloud.google.com/apis/credentials (Web application), and set
# the redirect to <your-origin>/auth/google/callback.
# WEB_TERMINAL_GOOGLE_CLIENT_ID=
# WEB_TERMINAL_GOOGLE_CLIENT_SECRET=
# WEB_TERMINAL_GOOGLE_REDIRECT=https://terminal.example.com/auth/google/callback
# Restrict who can log in (pick one; if BOTH are empty, ANY verified Google
# account is accepted — do not do that on a public instance):
# WEB_TERMINAL_ALLOWED_DOMAIN=example.com
# WEB_TERMINAL_ALLOWED_EMAILS=you@example.com,teammate@example.com

# Method C — local-network bypass. Trusts requests coming directly (not via a
# proxy) from loopback / RFC1918 / Tailscale ranges. Convenient, but read the
# README: it trusts the whole private range, not just your devices.
# WEB_TERMINAL_LOCAL_BYPASS=0

# ── Shell / limits ───────────────────────────────────────────────────────────
# Shell to spawn. Defaults to $SHELL, or /bin/bash if unset.
# WEB_TERMINAL_SHELL=/bin/bash
# Max concurrent terminals per user.
WEB_TERMINAL_MAX_SESSIONS=24
# Where audit logs go.
# WEB_TERMINAL_LOG_DIR=./logs
