{
  "name": "web-terminal",
  "version": "0.4.0",
  "private": true,
  "description": "Browser terminal: ttyd-like backend (PTY + WebSocket + cookie auth) with an xterm.js frontend (ghostty-web optional) and split panes.",
  "type": "commonjs",
  "main": "server.js",
  "scripts": {
    "build": "node scripts/build.js",
    "themes": "node scripts/fetch-themes.js",
    "watch": "node scripts/build.js --watch",
    "start": "node server.js"
  },
  "dependencies": {
    "@xterm/addon-serialize": "0.13.0",
    "@xterm/headless": "5.5.0",
    "cookie-parser": "^1.4.7",
    "express": "^4.21.2",
    "express-ws": "^5.0.2",
    "node-pty": "1.2.0-beta.12",
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "@fontsource/fira-code": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/iosevka": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@xterm/addon-clipboard": "0.1.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-image": "0.8.0",
    "@xterm/addon-search": "0.15.0",
    "@xterm/addon-unicode11": "0.8.0",
    "@xterm/addon-web-links": "0.11.0",
    "@xterm/addon-webgl": "0.18.0",
    "@xterm/xterm": "^5.5.0",
    "esbuild": "^0.28.2",
    "ghostty-web": "^0.2.0"
  },
  "engines": {
    "node": ">=20"
  }
}
