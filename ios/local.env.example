# Your settings for the iOS / Mac app builds. The build scripts ask for these
# the first time and write ios/local.env (git-ignored); you can also copy this
# file there and fill it in by hand.

# Public URL of your web-terminal (the one behind your login).
WT_SERVER_URL=https://terminal.example.com/

# Optional: the same server on your home network. The apps only switch to it
# after it proves it is your server (see README, "Direct connection at home").
# Leave empty to always use the public URL.
WT_LAN_URL=

# Bundle identifier of the app. It must be unique to you (reverse-DNS style).
WT_BUNDLE_ID=com.yourname.webterminal
