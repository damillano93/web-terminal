# Copy to ios/local.env (git-ignored) and set your own server. Read by
# scripts/ios-build.sh and scripts/mac-build.sh.

# Public URL of your web-terminal (the one behind your login).
WT_SERVER_URL=https://terminal.example.com/

# Optional: the same server on your home network. The apps only switch to it
# after it proves it is your server (see README, "iOS app"). Leave empty to
# always use the public URL.
WT_LAN_URL=
